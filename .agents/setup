#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "[setup] Node $(node --version), pnpm $(pnpm --version)"

started_at=$SECONDS
echo "[setup] Installing dependencies from pnpm-lock.yaml"
pnpm install --frozen-lockfile
echo "[setup] Dependencies ready in $((SECONDS - started_at))s"
